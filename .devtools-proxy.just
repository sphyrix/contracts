# AUTO-GENERATED by devtools — do not edit.
# Regenerate with: devtools update

# Ensures container is running and proxy file is up to date
[private]
_ensure:
    #!/usr/bin/env bash
    set -euo pipefail
    # Already inside a devtools container — skip container management
    if [ "${DEVTOOLS_CONTAINER:-}" = "1" ]; then
        exit 0
    fi
    CONTAINER="devtools-contracts"
    IMAGE="ghcr.io/sphyrix/devtools:latest"
    PROJECT_DIR="$(pwd)"
    EPHEMERAL="{{ephemeral}}"

    if ! docker info > /dev/null 2>&1; then
        echo "Error: Docker isn't running. Start Docker and try again." >&2
        exit 1
    fi

    # Ephemeral mode: tear down existing container
    if [ "${EPHEMERAL}" = "true" ]; then
        docker rm -f "$CONTAINER" 2>/dev/null || true
    fi

    # Check if container is running
    if ! docker ps -q -f "name=^${CONTAINER}$" -f "status=running" | grep -q .; then
        echo "Starting devtools container..."
        docker rm -f "$CONTAINER" 2>/dev/null || true

        # Read secrets from ~/.sphyrix/cli.toml and pass as env vars
        ENV_ARGS=""
        SECRETS_FILE="$HOME/.sphyrix/cli.toml"
        if [ -f "$SECRETS_FILE" ]; then
            while IFS='= ' read -r key value; do
                key=$(echo "$key" | xargs)
                value=$(echo "$value" | xargs | tr -d '"')
                [ -n "$key" ] && [ -n "$value" ] && ENV_ARGS="$ENV_ARGS -e ${key^^}=$value"
            done < <(sed -n '/^\[secrets\]/,/^\[/p' "$SECRETS_FILE" | grep -v '^\[' | grep '=')
        fi

        # Pass through docker-target inputs so recipes can derive the ghcr
        # image path from the GitHub repo context (or honour explicit
        # DOCKER_IMAGE / IMAGE_TAG / DOCKER_BUILD_ARGS overrides, plus
        # DOCKER_BUILD_CONTEXT / DOCKERFILE for a Dockerfile that does not
        # live at the project root).
        for var in GITHUB_REPOSITORY DOCKER_IMAGE IMAGE_TAG DOCKER_BUILD_ARGS DOCKER_BUILD_CONTEXT DOCKERFILE; do
            if [ -n "${!var:-}" ]; then
                ENV_ARGS="$ENV_ARGS -e ${var}=${!var}"
            fi
        done

        # THE secrets interface (portable across laptop/CI): recipes read env
        # vars only, and env vars are handed over as a file of KEY=VALUE lines.
        # DEVTOOLS_ENV_FILE wins; a plain .env in the project root is the
        # default. NOTE: env enters at container START — after editing the env
        # file, run "just clean" so the next target starts a fresh container.
        ENV_FILE="${DEVTOOLS_ENV_FILE:-}"
        if [ -z "$ENV_FILE" ] && [ -f .env ]; then
            ENV_FILE=".env"
        fi
        if [ -n "$ENV_FILE" ]; then
            if [ ! -f "$ENV_FILE" ]; then
                echo "Error: DEVTOOLS_ENV_FILE=$ENV_FILE does not exist" >&2
                exit 1
            fi
            ENV_ARGS="$ENV_ARGS --env-file $ENV_FILE"
        fi

        # Mount the host Docker socket (when present) so docker addon targets
        # (docker-build/docker-publish) work from inside the container — CI
        # container jobs get the socket mounted by the runner, this is the
        # local equivalent.
        MOUNT_ARGS=""
        if [ -S /var/run/docker.sock ]; then
            MOUNT_ARGS="-v /var/run/docker.sock:/var/run/docker.sock"
        fi

        # Forward the host's git-over-SSH access so private repos (e.g.
        # private Go modules routed via a url.git@github.com:.insteadOf
        # rewrite) work without any token on disk. Prefer the ssh-agent
        # socket — keys never enter the container; fall back to a READ-ONLY
        # ~/.ssh mount for agent-less setups.
        if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
            MOUNT_ARGS="$MOUNT_ARGS -v ${SSH_AUTH_SOCK}:/ssh-agent"
            ENV_ARGS="$ENV_ARGS -e SSH_AUTH_SOCK=/ssh-agent"
        elif [ -d "$HOME/.ssh" ]; then
            MOUNT_ARGS="$MOUNT_ARGS -v $HOME/.ssh:/root/.ssh:ro"
        fi

        # ADR 001 addendum §5.5: kernel-TUN flags baked in here (not read at
        # runtime) when [tailnet].targets is non-empty, since this container
        # is shared by every proxied target — a project that adds
        # [tailnet].targets to an existing proxy needs "devtools update" and
        # "just clean" before its next target for the flags to take effect.
        docker run -d --name "$CONTAINER" -v "$PROJECT_DIR:/project" $MOUNT_ARGS $ENV_ARGS "$IMAGE"

        # Refresh proxy stubs to pick up any new targets
        docker exec "$CONTAINER" devtools regen-proxy >/dev/null
    fi

# Remove the project's devtools container
clean:
    #!/usr/bin/env bash
    CONTAINER="devtools-contracts"
    echo "Stopping and removing $CONTAINER..."
    docker rm -f "$CONTAINER" 2>/dev/null || true
    echo "Done."

build *args: _ensure
    just _run build {{args}}

test *args: _ensure
    just _run test {{args}}

lint *args: _ensure
    just _run lint {{args}}

fmt *args: _ensure
    just _run fmt {{args}}

proto-gen *args: _ensure
    just _run proto-gen {{args}}

proto-lint *args: _ensure
    just _run proto-lint {{args}}

proto-breaking *args: _ensure
    just _run proto-breaking {{args}}

proto-update *args: _ensure
    just _run proto-update {{args}}

_run target *args:
    #!/usr/bin/env bash
    if [ "${DEVTOOLS_CONTAINER:-}" = "1" ]; then
        devtools run {{target}} {{args}}
    else
        docker exec devtools-contracts devtools run {{target}} {{args}}
    fi
